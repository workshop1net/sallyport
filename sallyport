#!/usr/bin/env python3
"""Sallyport command line. The logic lives in sallyport_core.py."""
import os
import sys

# Python's isolated mode (-I, used by sallyport.cmd) does not put this script's
# directory on the path, so add it explicitly.
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))

from sallyport_core import main  # noqa: E402

if __name__ == "__main__":
    main()
